<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.cqrs4j.example</groupId>
        <artifactId>cqrs4j-example-root</artifactId>
        <version>0.6.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>org.fuin.cqrs4j.example.quarkus</groupId>
    <artifactId>cqrs4j-quarkus-example-root</artifactId>
    <packaging>pom</packaging>

    <properties>
        <quarkus.version>3.21.1</quarkus.version>
        <kurrentdb.version>26.1.0</kurrentdb.version>
    </properties>

    <dependencyManagement>

        <dependencies>

            <!-- Align gRPC to the version the KurrentDB client (kurrentdb-client 1.2.0) is built
                 against (1.71.0). quarkus-bom pins gRPC 1.69.1; unary RPCs (append/read) work across
                 that gap but the server-streaming subscribe RPC used by the projection push
                 subscriptions did not deliver events. Imported BEFORE quarkus-bom so it wins for the
                 io.grpc:* artifacts. -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>1.71.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Byte Buddy only supports the Java 25 class file format (major 69) from 1.17.5 on,
                 while quarkus-bom manages 1.15.11, which aborts the build augmentation on JDK 25.
                 org.fuin:bom already aligns on a Java-25-aware version, but it cannot be imported
                 here: it is built against Quarkus 3.23.4 and would pull every io.quarkus artifact
                 up to that version while the quarkus-maven-plugin stays at ${quarkus.version}.
                 A direct entry overrides the imported BOM. Keep in sync with org.fuin:bom. -->
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>${byte-buddy.version}</version>
            </dependency>

            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy-agent</artifactId>
                <version>${byte-buddy.version}</version>
            </dependency>

            <!-- The KurrentDB client (kurrentdb-client 1.2.0) generates its gRPC/protobuf stubs
                 against protobuf-java 4.28.2 (needs com.google.protobuf.RuntimeVersion). quarkus-bom
                 pins the older 3.25.x line, so the generated code fails at runtime with
                 NoClassDefFoundError RuntimeVersion$RuntimeDomain. A direct dependencyManagement
                 entry overrides the imported BOM and realigns protobuf for the KurrentDB client. -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>4.28.2</version>
            </dependency>

            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java-util</artifactId>
                <version>4.28.2</version>
            </dependency>

        </dependencies>

    </dependencyManagement>

    <modules>
        <module>shared</module>
        <module>query</module>
        <module>command</module>
    </modules>

</project>
