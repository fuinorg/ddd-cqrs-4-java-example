<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.4.4</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>

	<groupId>org.fuin.cqrs4j.example.spring</groupId>
	<artifactId>cqrs4j-spring-example-root</artifactId>
	<version>0.6.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<properties>
		<java.version>17</java.version>
		<maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<cqrs4j.version>0.7.0-SNAPSHOT</cqrs4j.version>
		<ddd4j.version>0.8.0-SNAPSHOT</ddd4j.version>
		<objects4j.version>0.12.0-SNAPSHOT</objects4j.version>
		<esc.version>0.10.0-SNAPSHOT</esc.version>
		<utils4j.version>0.15.1-SNAPSHOT</utils4j.version>
		<kurrentdb.version>26.1.0</kurrentdb.version>
	</properties>
	
	<dependencyManagement>

		<dependencies>

			<!-- Align all Spring Framework artifacts to a single version. A fuin BOM pulls
			     spring-context/core at 6.2.18 while spring-boot-starter-parent 3.4.4 manages
			     spring-beans at 6.2.5; the split causes a NoSuchMethodError
			     (ConfigurableListableBeanFactory.prepareSingletonBootstrap) at context refresh.
			     Importing the spring-framework-bom first keeps every spring-* artifact aligned. -->
			<dependency>
				<groupId>org.springframework</groupId>
				<artifactId>spring-framework-bom</artifactId>
				<version>6.2.18</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Align all JUnit 5 artifacts to a single version. The fuin BOMs pull the
			     junit-jupiter aggregator/engine at 5.12.x while spring-boot-starter-parent
			     3.4.4 manages junit-jupiter-api at 5.11.4; importing the junit-bom first
			     keeps api/params/engine/platform consistent and avoids a discovery-time
			     NoClassDefFoundError. -->
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>5.12.2</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- fuin library BOMs (manage all fuin artifact versions) -->

			<dependency>
				<groupId>org.fuin.cqrs4j</groupId>
				<artifactId>cqrs-4-java-bom</artifactId>
				<version>${cqrs4j.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<dependency>
				<groupId>org.fuin.ddd4j</groupId>
				<artifactId>ddd-4-java-bom</artifactId>
				<version>${ddd4j.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<dependency>
				<groupId>org.fuin.esc</groupId>
				<artifactId>esc-bom</artifactId>
				<version>${esc.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<dependency>
				<groupId>org.fuin.objects4j</groupId>
				<artifactId>objects4j-bom</artifactId>
				<version>${objects4j.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- artifacts not managed by a fuin BOM -->

			<dependency>
	            <groupId>org.glassfish.expressly</groupId>
	            <artifactId>expressly</artifactId>
	            <version>5.0.0</version>
			</dependency>

			<dependency>
				<groupId>org.fuin</groupId>
				<artifactId>units4j</artifactId>
				<version>0.12.0</version>
			</dependency>

			<dependency>
				<groupId>nl.jqno.equalsverifier</groupId>
				<artifactId>equalsverifier</artifactId>
				<version>3.15.5</version>
			</dependency>

			<dependency>
				<groupId>commons-io</groupId>
				<artifactId>commons-io</artifactId>
				<version>2.15.1</version>
			</dependency>

		</dependencies>
		
	</dependencyManagement>	

	<build>
	
		<pluginManagement>
	
			<plugins>
			
	            <plugin>
	                <groupId>io.fabric8</groupId>
	                <artifactId>docker-maven-plugin</artifactId>
	                <version>0.43.4</version>
				</plugin>

				<plugin>
					<groupId>io.smallrye</groupId>
					<artifactId>jandex-maven-plugin</artifactId>
					<version>3.2.7</version>
					<executions>
						<execution>
							<id>make-index</id>
							<goals>
								<goal>jandex</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<!-- Byte Buddy 1.15.x (managed by spring-boot-starter-parent 3.4.4) rejects
				     Java 25 (class file major 69) during test-time bytecode generation
				     (Hibernate proxies, EqualsVerifier/Objenesis, Mockito). Allow it on the
				     forked test JVMs until a Java-25-aware Byte Buddy is on the classpath. -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<systemPropertyVariables>
							<net.bytebuddy.experimental>true</net.bytebuddy.experimental>
						</systemPropertyVariables>
					</configuration>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-failsafe-plugin</artifactId>
					<configuration>
						<systemPropertyVariables>
							<net.bytebuddy.experimental>true</net.bytebuddy.experimental>
						</systemPropertyVariables>
					</configuration>
				</plugin>

			</plugins>
			
		</pluginManagement>
	
	</build>

	<repositories>

		<repository>
			<id>central-snapshots</id>
			<name>Central Portal Snapshots</name>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<updatePolicy>always</updatePolicy>
				<enabled>true</enabled>
			</snapshots>
		</repository>

	</repositories>

	<modules>
		<module>shared</module>
		<module>query</module>
		<module>command</module>
	</modules>

</project>
